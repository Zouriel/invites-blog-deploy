# Copy to .env on the server and fill in secrets. Never commit the real .env.
POSTGRES_DB=invites_blog
POSTGRES_USER=invites
POSTGRES_PASSWORD=CHANGE_ME_strong_password
JWT_SIGNING_KEY=CHANGE_ME_long_random_at_least_32_chars
ADMIN_EMAIL=admin@invites.blog
ADMIN_PASSWORD=CHANGE_ME_admin_password
PAYMENTS_WEBHOOK_SECRET=fake-webhook-secret

# Email (Resend). Leave EMAIL_PROVIDER=Console to just log emails; set Resend to go live.
EMAIL_PROVIDER=Console
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_INVITES=invites.blog <invites@mail.invites.blog>
EMAIL_FROM_SYSTEM=invites.blog <no-reply@mail.invites.blog>
OTP_CHANNELS=Email
