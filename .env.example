# Copy to .env on the server and fill in secrets. Never commit the real .env.

# GitHub token (classic, read:packages scope) used only at image-build time to install the
# private @zouriel/ui package from GitHub Packages. Not needed at runtime.
NODE_AUTH_TOKEN=CHANGE_ME_github_token_with_read_packages_scope

POSTGRES_DB=invites_blog
POSTGRES_USER=invites
POSTGRES_PASSWORD=CHANGE_ME_strong_password
JWT_SIGNING_KEY=CHANGE_ME_long_random_at_least_32_chars
ADMIN_EMAIL=admin@invites.blog
ADMIN_PASSWORD=CHANGE_ME_admin_password
PAYMENTS_WEBHOOK_SECRET=fake-webhook-secret

# Email (Resend). Leave EMAIL_PROVIDER=Console to just log emails; set Resend to go live.
EMAIL_PROVIDER=Console
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_INVITES=invites.blog <invites@invites.blog>
EMAIL_FROM_SYSTEM=invites.blog <no-reply@invites.blog>
# Add Sms once MSGOWL_API_KEY is set below, e.g. OTP_CHANNELS=Email,Sms
OTP_CHANNELS=Email
# SMS OTP (MsgOwl). Empty key = phone sign-in stays off and the UI hides it.
# Sender ID must be <=11 alphanumeric GSM characters (no dots) or the carrier rejects it.
MSGOWL_API_KEY=
MSGOWL_SENDER_ID=InvitesBlog

# Viber (Infobip Business Messages). Leave INFOBIP_API_KEY empty to keep Viber log-only (no real sends).
# BASE_URL is your account-specific host from the Infobip portal (https://xxxxx.api.infobip.com).
# WEBHOOK_TOKEN is a long random shared secret our delivery-report endpoint requires.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_VIBER_SENDER=invitesblog
INFOBIP_WEBHOOK_TOKEN=

# Object storage (MinIO, S3-compatible). Set STORAGE_PROVIDER=Minio to store template packages
# and campaign images in MinIO instead of the API's disk volume. Public reads are served via
# Caddy's /assets/* route. Leave STORAGE_PROVIDER unset/Local to use the disk volume.
STORAGE_PROVIDER=Minio
STORAGE_ENDPOINT=http://invites-blog-minio:9000
STORAGE_BUCKET=invites-assets
MINIO_ROOT_USER=invitesblog
MINIO_ROOT_PASSWORD=CHANGE_ME_long_random_minio_password

# Social sign-in (OpenID Connect, browser implicit flow — no client secret needed).
# Google: console.cloud.google.com > Credentials > OAuth client ID > Web application.
#   Authorised JavaScript origin: https://invites.blog
#   Authorised redirect URI:      https://invites.blog/oauth/callback
# Leave empty to hide the provider's button entirely.
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_TENANT=common
