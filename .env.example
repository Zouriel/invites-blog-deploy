# Copy to .env on the server and fill in secrets. Never commit the real .env.

# GitHub token (classic, read:packages scope) used only at image-build time to install the
# private @zouriel/ui package from GitHub Packages. Not needed at runtime.
NODE_AUTH_TOKEN=CHANGE_ME_github_token_with_read_packages_scope

POSTGRES_DB=invites_blog
POSTGRES_USER=invites
POSTGRES_PASSWORD=CHANGE_ME_strong_password
JWT_SIGNING_KEY=CHANGE_ME_long_random_at_least_32_chars
ADMIN_EMAIL=admin@invites.blog
ADMIN_PASSWORD=CHANGE_ME_admin_password
PAYMENTS_WEBHOOK_SECRET=fake-webhook-secret
# Bank of Maldives (BML Connect). Keep PAYMENTS_ENABLED=false until the UAT test passes.
PAYMENTS_ENABLED=false
PAYMENTS_PROVIDER=Bml
BML_BASE_URL=https://api.uat.merchants.bankofmaldives.com.mv
BML_API_KEY=

# Email (Resend). Leave EMAIL_PROVIDER=Console to just log emails; set Resend to go live.
EMAIL_PROVIDER=Console
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM_INVITES=invites.blog <invites@invites.blog>
EMAIL_FROM_SYSTEM=invites.blog <no-reply@invites.blog>
# Add Sms once MSGOWL_API_KEY is set below, e.g. OTP_CHANNELS=Email,Sms
OTP_CHANNELS=Email
# SMS OTP (MsgOwl). Empty key = phone sign-in stays off and the UI hides it.
# Sender ID must be <=11 alphanumeric GSM characters (no dots) or the carrier rejects it.
MSGOWL_API_KEY=
MSGOWL_SENDER_ID=Invitesblog

# Viber (Infobip Business Messages). Leave INFOBIP_API_KEY empty to keep Viber log-only (no real sends).
# BASE_URL is your account-specific host from the Infobip portal (https://xxxxx.api.infobip.com).
# WEBHOOK_TOKEN is a long random shared secret our delivery-report endpoint requires.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_VIBER_SENDER=invitesblog
INFOBIP_WEBHOOK_TOKEN=

# Object storage (MinIO, S3-compatible). Set STORAGE_PROVIDER=Minio to store template packages
# and campaign images in MinIO instead of the API's disk volume. Public reads are served via
# Caddy's /assets/* route. Leave STORAGE_PROVIDER unset/Local to use the disk volume.
STORAGE_PROVIDER=Minio
STORAGE_ENDPOINT=http://invites-blog-minio:9000
STORAGE_BUCKET=invites-assets
# Storage credentials are their own variables, not MinIO's root login — the two backends need to be
# able to differ. For MinIO, set these to MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Cloudflare R2 only: STORAGE_PROVIDER=S3, STORAGE_REGION=auto,
# STORAGE_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com, STORAGE_BUCKET=<r2 bucket>.
# Browser reads come from the bucket's custom domain via Caddy, never from that endpoint.
STORAGE_REGION=
# The MinIO bucket the init container creates. Separate from STORAGE_BUCKET so that pointing the app
# at R2 does not rename the bucket MinIO is holding as the rollback.
MINIO_BUCKET=invites-assets
MINIO_ROOT_USER=invitesblog
MINIO_ROOT_PASSWORD=CHANGE_ME_long_random_minio_password

# Social sign-in (OpenID Connect, browser implicit flow — no client secret needed).
# Google: console.cloud.google.com > Credentials > OAuth client ID > Web application.
#   Authorised JavaScript origin: https://invites.blog
#   Authorised redirect URI:      https://invites.blog/oauth/callback
# Leave empty to hide the provider's button entirely.
OAUTH_GOOGLE_CLIENT_ID=
# Extra Google client ids accepted for sign-in (comma-separated); compose defaults to the iOS app's client.
OAUTH_GOOGLE_ADDITIONAL_CLIENT_IDS=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_TENANT=common
# Sign in with Apple (iPhone app). Sign-in works with compose's defaults (bundle id, team id).
# To revoke Apple tokens when an account is deleted (App Store 5.1.1(v)), create a key with
# "Sign in with Apple" enabled (developer.apple.com > Keys), then set its id and the .p8 contents
# on one line with \n between lines. Empty = sign-in on, revocation off.
APPLE_SIGNIN_KEY_ID=
APPLE_SIGNIN_PRIVATE_KEY=

# Google Play purchases in the app. Leave empty to keep them off.
GOOGLE_PLAY_PACKAGE_NAME=
# The service account's JSON key as ONE line, in single quotes. Secret: never commit it.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Accept license testers' test purchases. On only while testing; refused otherwise.
GOOGLE_PLAY_ALLOW_TEST_PURCHASES=false
# Real-time notifications (Pub/Sub push): the audience and service account set on the push subscription.
GOOGLE_PLAY_NOTIFICATIONS_AUDIENCE=
GOOGLE_PLAY_NOTIFICATIONS_EMAIL=

# App Store purchases in the iPhone app. Leave empty to keep them off.
APP_STORE_BUNDLE_ID=
# App Store Connect > Users and Access > Integrations > In-App Purchase: the Issuer ID and the key's Key ID.
APP_STORE_ISSUER_ID=
APP_STORE_KEY_ID=
# The .p8 key's text as ONE line, in single quotes, with \n where its line breaks are. Secret: never commit it.
APP_STORE_PRIVATE_KEY=
# The app's Apple ID (a number, App Store Connect > App Information). Production notifications for another app are ignored.
APP_STORE_APP_APPLE_ID=
# Accept sandbox (TestFlight, sandbox tester) purchases. On only while testing; refused otherwise.
APP_STORE_ALLOW_TEST_PURCHASES=false
