# invites.blog routes for the shared Caddy proxy.
# Copy this file into /opt/stacks/proxy/Caddyfile.d/ and run:  docker exec caddy caddy reload --config /etc/caddy/Caddyfile
# Each site proxies /api/* to the API and /assets/* to MinIO object storage (same-origin, no CORS),
# and everything else to the SPA. /assets/{key} maps to the MinIO bucket object invites-assets/{key}.

# Behind the Cloudflare tunnel Caddy's peer is the cloudflared container, so the API would see that one
# address for every visitor. Hand it the visitor from CF-Connecting-IP (only Cloudflare reaches Caddy).
(ib_api_upstream) {
	reverse_proxy invites-blog-api:8080 {
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	}
}

# --- Object storage: the ONE place /assets/* is defined ---------------------------------------
#
# Four hosts serve /assets/*, and they must all point at the same backend. A half-migrated proxy
# means some invitations load their photos and some don't, which is a miserable thing to debug — so
# the route lives here once and every host imports it, making the MinIO -> R2 cutover a one-line
# change instead of four identical ones.
#
# LIVE since 2026-08-27: Cloudflare R2, via the bucket's custom domain.
(assets) {
	# Designs a CUSTOMER uploaded are NOT served to browsers. Anyone can upload one, nothing reviews
	# it, and everything under /assets/* is proxied onto the app's own origin as text/html with no
	# CSP — where the session token sits in localStorage. A document reachable here would therefore
	# be unreviewed markup running with a session in reach.
	#
	# The renderer does not need this route: it reads the document server-side from object storage
	# by key and serves it inline, sandboxed, under default-src 'none'. So refusing it costs the
	# product nothing and closes the whole class. The design's IMAGES are inert and live under
	# /assets/campaigns/*, which is served normally.
	#
	# Keep this ABOVE the general handler — Caddy takes the most specific matcher, but the ordering
	# is what makes the intent obvious to whoever reads this next.
	handle /assets/imported/* {
		respond 404
	}
	# What people UPLOAD (event photos and videos under buckets/, and campaign images such as covers
	# under campaigns/) is served from the app's own origin. The upload path now refuses SVG, but
	# anything stored before that (or a file whose bytes lie about their type) must still never run
	# as a document here. nosniff stops a browser second-guessing the stored type; the sandbox CSP
	# means a file opened directly gets an opaque origin with no scripts. An <img> or <video> on a
	# page is unaffected: a CSP on an image response only applies when it is the top-level document.
	# Template packages (templates/*) are NOT covered: designs need their scripts, and they run in
	# sandboxed frames of their own.
	@usermedia path /assets/buckets/* /assets/campaigns/*
	header @usermedia {
		X-Content-Type-Options nosniff
		Content-Security-Policy "default-src 'none'; img-src 'self' data:; media-src 'self'; style-src 'unsafe-inline'; sandbox"
	}
	# The template designer's self-hosted fonts. An invitation renders on an OPAQUE origin (the CSP
	# sandbox on /r/*, and sandboxed preview frames in the app), and a browser fetches fonts in CORS
	# mode — so without this header every font request from an invitation is refused, even though it
	# is the same host. Fonts are public files; allowing any origin exposes nothing.
	@fonts path /assets/fonts/*
	header @fonts Access-Control-Allow-Origin "*"
	handle_path /assets/* {
		reverse_proxy https://assets.invites.blog {
			header_up Host assets.invites.blog
		}
	}
}

# ROLLBACK to MinIO — swap the body above back to:
#
#   handle_path /assets/* {
#       rewrite * /invites-assets{uri}
#       reverse_proxy invites-blog-minio:9000
#   }
#
# and set STORAGE_* in .env back to the MinIO values. The MinIO container and its volume are kept
# mounted for exactly this. Anything uploaded since the cutover lives only in R2, so a rollback needs
# a mirror back the other way first — R2 -> MinIO — or those assets 404.
#
# assets.invites.blog is the bucket's custom domain: public and CDN-fronted. NOT the S3 API endpoint
# from the .env — that one requires a signature on every request, which Caddy cannot produce, and
# pointing a CNAME at it earns Cloudflare error 1014.
#
# The `rewrite` goes with MinIO: /invites-assets is a MinIO bucket-path artefact, not part of the
# key. Cache-Control needs no rule here — it is set on each object at upload (StorageCache), which
# is exactly what makes it survive this move.

# invites.blog is the PUBLIC site since 2026-11-13: landing, Plans, guides, policies, design pages, and the
# QR cards' /q/ pages. The signed-in web app is app.invites.blog (below). The API stays here too, for the
# shipped mobile apps and the BML webhook.
invites.blog {
	handle /api/* {
		import ib_api_upstream
	}
	# A page load of a web-app address here goes to the same address on app.invites.blog, query included, so
	# old links, bookmarks and emails keep working (302: the split may still be tuned). Signed-in people are
	# not signed out by it: app.invites.blog asks this host once for the sign-in it holds (/handoff).
	# Must match the app's own list (invites-blog-frontend, shared/services/host-split.ts, isSitePath):
	# everything that isn't a site page. Clicks inside the page never reach Caddy; the app redirects those.
	@app_paths path /me /me/* /feed /feed/* /inbox /inbox/* /favourites /favourites/* /login /login/* /join /join/* /signup /signup/* /billing /billing/* /events/* /invitation/* /buckets/* /create/* /dashboard/* /design/* /designer /designer/* /template-designer /template-designer/* /my-templates /my-templates/* /studio /studio/* /admin /admin/* /templates /portfolio /portfolio/*
	handle @app_paths {
		redir https://app.invites.blog{uri} 302
	}
	# Sign in with Apple's return URL (fixed on the Services ID blog.invites.web). Apple POSTs the result
	# here (response_mode=form_post), which the static SPA can't receive, so this ONE exact path goes to the
	# API; it checks the state and answers with a redirect back into the SPA. Without this block the POST
	# falls through to nginx and the sign-in ends on an error page. Harmless while web sign-in is off.
	handle /auth/apple/callback {
		import ib_api_upstream
	}
	# Studio portfolios (docs/PORTFOLIO.md): invites.blog/@handle is rendered by the API, so link previews and
	# search see the real page. Must stay on this host (shared links, printed cards).
	handle /@* {
		import ib_api_upstream
	}
	# The published portfolios, for search engines (robots.txt lists it beside the build's sitemap.xml). Made by
	# the API because portfolios change between builds.
	handle /sitemap-portfolios.xml {
		import ib_api_upstream
	}
	import assets
	handle {
		reverse_proxy invites-blog-web-inviter:80
	}
}

# The signed-in web app (2026-11-13): the same web-inviter build as invites.blog, which decides by its host
# what to show. Its own /api for same-origin calls; nothing here is for search engines.
app.invites.blog {
	header X-Robots-Tag "noindex, nofollow"
	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	handle /api/* {
		import ib_api_upstream
	}
	# A portfolio is a public page: it lives on invites.blog.
	handle /@* {
		redir * https://invites.blog{uri} 301
	}
	import assets
	# No landing page in the app: it opens on the feed (signed out, the feed asks them to sign in).
	handle / {
		# "*" first: a lone path would be read as a matcher, and "302" as the target.
		redir * /feed 302
	}
	handle {
		reverse_proxy invites-blog-web-inviter:80
	}
}

me.invites.blog {
	handle /api/* {
		import ib_api_upstream
	}
	# The server-rendered guest path. /i/{token} admits (token + IP trust, OTP from an unrecognised
	# network) and hands out an HttpOnly cookie; /r/{renderId} is the invitation itself — one
	# pre-filled top-level document, no iframe, served under a CSP sandbox that gives it an opaque
	# origin. Everything else on this host still goes to the Angular app, so /inbox, /login,
	# /e/{campaignId} and /invites/{id} are untouched. To roll back, delete these two blocks and
	# reload: /i/* falls straight back to the Angular invitee app.
	handle /i/* {
		import ib_api_upstream
	}
	handle /r/* {
		import ib_api_upstream
	}
	# The OPEN LINK: one short address anybody may follow, for a customer who brought their own
	# artwork and has no guest list. Admits on possession of the code alone and redirects into
	# /r/{renderId} like every other door. This block is load-bearing — without it /o/* falls
	# through to the Angular invitee app, which answers 200 to anything, so the link would look
	# like it worked and render an empty shell.
	handle /o/* {
		import ib_api_upstream
	}
	# The cross-host handoff: the account app mints a one-hop admission, this host redeems it into
	# a cookie. Without this the path falls through to the SPA, which answers 200 to anything.
	handle /h/* {
		import ib_api_upstream
	}
	import assets
	handle {
		reverse_proxy invites-blog-web-invitee:80
	}
}

# --- Immediate-access fallback (works without any DNS change) ---
invites.164.68.102.231.sslip.io {
	handle /api/* {
		import ib_api_upstream
	}
	import assets
	handle {
		reverse_proxy invites-blog-web-inviter:80
	}
}

me-invites.164.68.102.231.sslip.io {
	handle /api/* {
		import ib_api_upstream
	}
	import assets
	handle {
		reverse_proxy invites-blog-web-invitee:80
	}
}
